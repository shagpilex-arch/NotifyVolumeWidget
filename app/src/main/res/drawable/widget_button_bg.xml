<?xml version="1.0" encoding="utf-8"?>
<!-- Used instead of the platform Button style: RemoteViews-hosted buttons are
     inflated using the launcher's own theme, so their built-in background and
     padding vary by device/launcher and isn't reliably centered (this is what
     caused the crooked-looking text). A plain TextView with this background
     gives full, predictable control over both. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#33FFFFFF" />
    <corners android:radius="14dp" />
</shape>
